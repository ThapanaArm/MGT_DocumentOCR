{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "backend/src/MgtOcr.Api/MgtOcr.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "detail": "Compiles MgtOcr.Api (and its project references) — used as the debugger's preLaunchTask."
    },
    {
      "label": "Run Backend (.NET)",
      "type": "shell",
      "command": "dotnet",
      "args": ["run", "--project", "backend/src/MgtOcr.Api/MgtOcr.Api.csproj"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "run-all", "panel": "dedicated", "clear": true },
      "detail": "ASP.NET Core API on http://localhost:8091 (DOTNET_APP_PORT in .env overrides)."
    },
    {
      "label": "Run Frontend (Vite dev)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/webfront" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "run-all", "panel": "dedicated", "clear": true },
      "detail": "React (Vite) dev server on http://localhost:5173 — proxies /api to the .NET backend on :8091 (see webfront/vite.config.ts). Run 'npm install' in webfront/ once first."
    },
    {
      "label": "Run All (Frontend + Backend)",
      "dependsOn": ["Run Backend (.NET)", "Run Frontend (Vite dev)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
