{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MgtOcr.Api (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/src/MgtOcr.Api/bin/Debug/net10.0/MgtOcr.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/MgtOcr.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": ".NET Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
