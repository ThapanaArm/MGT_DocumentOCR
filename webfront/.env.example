# Vite environment for MGT Document OCR — copy to .env.local and fill in.
#
# Leave VITE_AZURE_CLIENT_ID EMPTY and the app runs with sign-in switched off, exactly as it did
# before SSO existed. Fill it in and the sign-in screen appears. The backend has the matching
# switch in appsettings.json (AzureAd:Tenants) and refuses to start unauthenticated outside
# Development, so the two cannot drift apart unnoticed.

VITE_USE_MOCK=0

# Application (client) ID of the SPA app registration in Entra ID. Not a secret — it ships to the
# browser by design. What actually protects the app is the redirect URI allowlist in Entra plus the
# Ms_User check on the server.
VITE_AZURE_CLIENT_ID=

# Leave as-is unless you deliberately want to restrict sign-in to a single tenant at the browser.
# The real tenant allowlist lives on the server (AzureAd:Tenants).
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/organizations

# Defaults to api://<client id>/access_as_user; set only if the scope was named differently.
VITE_AZURE_API_SCOPE=
