<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS settings for the published API. The publish step generates its own <aspNetCore> element and
  merges it with this file, so only what IIS itself needs to be told goes here.

  requestLimits: IIS rejects a request larger than ~28.6 MB (its 30,000,000-byte default) before
  ASP.NET ever sees it, so the [RequestSizeLimit] attributes on the upload endpoints cannot raise
  the ceiling on their own — a scanned bundle over that size failed with a bare 413. Kept in step
  with those attributes at 200 MB.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
