<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Dev secrets (e.g. Archive:Targets:0:ClientSecret): right-click the project > Manage User Secrets -->
    <UserSecretsId>mgtocr-api-fcf4ba88-bc2f-4aec-91ff-b324fb212197</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Writes the Input VAT / Journal Voucher / SAP Import workbooks Finance uploads into SAP. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SAP "Import Supplier Invoices" template exactly as that app hands it out. The export
         opens this file and writes rows into it rather than rebuilding the sheet, so the hidden
         technical-name row, the hidden columns and the section bands can never drift. -->
    <None Update="Export\Templates\SupplierInvoice_EN.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MgtOcr.Core\MgtOcr.Core.csproj" />
    <ProjectReference Include="..\MgtOcr.Ocr\MgtOcr.Ocr.csproj" />
    <ProjectReference Include="..\MgtOcr.Data\MgtOcr.Data.csproj" />
    <ProjectReference Include="..\MgtOcr.Sap\MgtOcr.Sap.csproj" />
    <ProjectReference Include="..\MgtOcr.Zoho\MgtOcr.Zoho.csproj" />
  </ItemGroup>

</Project>
