<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MgtOcr.Core\MgtOcr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Tesseract shell-out + PDFtoImage's PDFium binding are used here as this deployment's
         actual runtime (Windows, per this project's SQL Server/Tesseract setup) — declaring it
         resolves the CA1416 platform-compatibility warnings on those calls truthfully rather
         than suppressing them blindly. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

</Project>
